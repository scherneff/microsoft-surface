   "section": "hp-features",
   "items": [
    {
     "role": "heading",
     "order": 0,
     "text": "Get to know AI and Copilot"
    },
    {
     "role": "heading",
     "order": 1,
     "text": "Shaping the future of representation in AI"
    },
    {
     "role": "body",
     "order": 2,
     "text": "With help from a new Microsoft platform, advocacy groups can train AI systems to generate images that portray underrepresented communities more accurately."
    },
    {
     "role": "cta",
     "order": 3,
     "text": "Learn more",
     "href": "https://news.microsoft.com/signal/articles/a-new-approach-to-ai-data-puts-communities-in-charge/?icid=mscom_marcom_CPAI1a_CommunityLibraries"
    },
    {
     "role": "heading",
     "order": 4,
     "text": "Turning words into apps"
    },
    {
     "role": "body",
     "order": 5,
     "text": "“Vibe coding” allows people to build software by talking through an idea with a Microsoft AI tool that writes the code."
    },
    {
     "role": "cta",
     "order": 6,
     "text": "Learn more",
     "href": "https://news.microsoft.com/source/features/ai/vibe-coding-and-other-ways-ai-is-changing-who-can-build-apps-and-how/?icid=mscom_marcom_CPAI2a_AIVibeCoding"
    },
    {
     "role": "heading",
     "order": 7,
     "text": "When disaster strikes, HASTE can help"
    },
    {
     "role": "body",
     "order": 8,
     "text": "Using AI-assisted analysis, HASTE—a Microsoft tool—helps disaster response teams assess damage faster and direct aid where it's needed most."
    },
    {
     "role": "cta",
     "order": 9,
     "text": "Read the story",
     "href": "https://news.microsoft.com/source/features/ai/when-disaster-strikes-ai-helps-responders-reach-people-more-quickly/?icid=mscom_marcom_CPAI3a_DisasterResponse"
    }
   ],
