  {
   "section": "feature-card",
   "items": [
    {
     "role": "heading",
     "order": 0,
     "text": "Our opportunity and responsibility"
    },
    {
     "role": "body",
     "order": 1,
     "text": "We’re living in an era in which technology has the potential to power awesome advancements across every sector of our economy and society. This places us at a historic intersection of opportunity and responsibility. Our mission has never been more important. To realize it, we must create a future that benefits everyone."
    },
    {
     "role": "cta",
     "order": 2,
     "text": "Watch the video",
     "href": "#mission-video-dialog"
    }
   ],
   "imgCount": 1,
   "editableTexts": 1,
   "repeats": []
  },
  {
   "section": "commitments",
   "items": [
    {
     "role": "heading",
     "order": 0,
     "text": "We believe that companies that can do more, should"
    },
    {
     "role": "body",
     "order": 1,
     "text": "We focus on four enduring commitments that are central to our mission, serving as a guide to ensure our actions align with our mission."
    },
    {
     "role": "cta",
     "order": 2,
     "text": "Explore our commitments",
     "href": "https://www.microsoft.com/en-us/corporate-responsibility"
    },
    {
     "role": "heading",
     "order": 3,
     "text": "Expand opportunity"
    },
    {
     "role": "body",
     "order": 4,
     "text": "We expand economic opportunity and growth for all."
    },
    {
     "role": "heading",
     "order": 5,
     "text": "Earn trust"
    },
    {
     "role": "body",
     "order": 6,
     "text": "We create a safe, secure, and responsible digital world."
    },
    {
     "role": "heading",
     "order": 7,
     "text": "Protect fundamental rights"
    },
    {
     "role": "body",
     "order": 8,
     "text": "We support and advance people’s fundamental rights."
    },
    {
     "role": "heading",
     "order": 9,
     "text": "Advance sustainability"
    },
    {
     "role": "body",
     "order": 10,
     "text": "We are committed to meeting our own climate goals while enabling others to do the same."
    }
   ],
