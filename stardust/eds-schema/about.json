    },
    {
     "role": "cta",
     "order": 4,
     "text": "Copilot for organizations",
     "href": "https://www.microsoft.com/en-us/microsoft-copilot/meet-copilot"
    },
    {
     "role": "heading",
     "order": 5,
     "text": "What will you do with Copilot?"
    },
    {
     "role": "heading",
     "order": 6,
     "text": "AI-powered coding for everyone"
    },
    {
     "role": "body",
     "order": 7,
     "text": "Engineers like Anton Mirhorodchenko are tackling accessibility issues in unprecedented ways."
    },
    {
     "role": "cta",
     "order": 8,
     "text": "Discover his story",
     "href": "https://unlocked.microsoft.com/copilot-voice/"
    },
    {
     "role": "heading",
     "order": 9,
     "text": "Pushing the game forward"
    },
    {
     "role": "body",
     "order": 10,
     "text": "The Billie Jean King Cup by Gainbridge is serving up better women's tennis stats with tech."
    },
    {
     "role": "cta",
     "order": 11,
     "text": "Explore the game-changing tech",
     "href": "https://unlocked.microsoft.com/billie-jean-king-cup/"
    },
    {
     "role": "cta",
     "order": 12,
     "text": "Explore what’s new with Copilot",
     "href": "https://aka.ms/about_copilot"
    }
   ],
