  {
   "section": "culture",
   "items": [
    {
     "role": "heading",
     "order": 0,
     "text": "Our culture and careers"
    },
    {
     "role": "heading",
     "order": 1,
     "text": "Because impact matters"
    },
    {
     "role": "body",
     "order": 2,
     "text": "At Microsoft you can live your purpose every day. With our scale and reach, your personal impact becomes part of a collective force for global progress."
    },
    {
     "role": "cta",
     "order": 3,
     "text": "Explore careers at Microsoft",
     "href": "https://careers.microsoft.com/"
    },
    {
     "role": "heading",
     "order": 4,
     "text": "Diversity & Inclusion"
    },
    {
     "role": "body",
     "order": 5,
     "text": "We believe our continued work to build diverse workforces and strengthen our culture of inclusion helps foster innovation."
    },
    {
     "role": "cta",
     "order": 6,
     "text": "Learn about diversity at Microsoft",
     "href": "https://www.microsoft.com/en-us/diversity"
    },
    {
     "role": "heading",
     "order": 7,
     "text": "Inclusion is innovation"
    },
    {
     "role": "body",
     "order": 8,
     "text": "We’re developing solutions to diversity and inclusion challenges by activating the same ingenuity, intention, and experience behind our groundbreaking technological innovations."
    },
    {
     "role": "cta",
     "order": 9,
     "text": "Explore the stories",
     "href": "https://aka.ms/inclusionisinnovation"
    }
   ],
