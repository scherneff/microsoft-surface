     "role": "heading",
     "order": 0,
     "text": "Microsoft Copilot"
    },
    {
     "role": "body",
     "order": 1,
     "text": "Your everyday AI companion"
    },
    {
     "role": "cta",
     "order": 2,
     "text": "Try Copilot",
     "href": "https://copilot.microsoft.com/onboarding"
    },
    {
     "role": "cta",
     "order": 3,
     "text": "Copilot for personal use",
