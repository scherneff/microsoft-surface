  {
   "section": "values",
   "items": [
    {
     "role": "heading",
     "order": 0,
     "text": "Our corporate values"
    },
    {
     "role": "body",
     "order": 1,
     "text": "Our values align to our mission, support our culture, and serve as a declaration of how we treat each other, our customers, and our partners."
    },
    {
     "role": "heading",
     "order": 2,
     "text": "Respect"
    },
    {
     "role": "body",
     "order": 3,
     "text": "We recognize that the thoughts, feelings, and backgrounds of others are as important as our own."
    },
    {
     "role": "heading",
     "order": 4,
     "text": "Integrity"
    },
    {
     "role": "body",
     "order": 5,
     "text": "We are honest, ethical, and trustworthy."
    },
    {
     "role": "heading",
     "order": 6,
     "text": "Accountability"
    },
    {
     "role": "body",
     "order": 7,
     "text": "We accept full responsibility for our decisions, actions, and results."
    }
   ],
